# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Cursor local
.cursor/

# Plastic SCM / Unity Version Control local (use Git instead)
**/.plastic/
tomCat/ignore.conf

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta noise sometimes regenerated; keep .meta of Assets tracked
# Crash / debug
sysinfo.txt
*.stackdump

# Autogenerated VS / Rider
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/

# Unity3D generated meta of above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Gradle / native caches under project if any
.gradle/
**/ExportedObj/

# Large local caches that should never be committed
tomCat/Library/
tomCat/Temp/
tomCat/Obj/
tomCat/Logs/
tomCat/UserSettings/
tomCat/MemoryCaptures/
